rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. IMMUTABLE AUDIT LOGS (APPEND-ONLY)
    // Logs cannot be edited or deleted once written - Enterprise Compliance
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // 2. TAKASHIMAYA CORE APPLICATION COLLECTIONS
    // Projects, Tasks, Costs, Delegation, Users, Rules, Config, Action Logs
    match /artifacts/{appId}/public/data/{collectionName}/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 3. CONNECTION TEST PROBE
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 4. DEFAULT-DENY CATCH ALL
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
