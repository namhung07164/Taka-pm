rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSafeFile() {
      // Limit file size to 50MB
      return request.resource.size < 50 * 1024 * 1024
        // Block executable and script files
        && !request.resource.name.matches('.*\\.(exe|bat|cmd|sh|bin|vbs|msi|dll|ps1)$');
    }

    match /taka_attachments/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isSafeFile();
      allow delete: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
